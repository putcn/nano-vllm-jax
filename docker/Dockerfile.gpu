# =============================================================================
# nano-vllm-jax — GPU Development Image
# Base: NVIDIA CUDA 12.4.1 + cuDNN 9 + Ubuntu 22.04
# JAX: jax[cuda12] via Google JAX releases
#
# Layer cache strategy (ordered by change frequency, low → high):
#   1. System packages     — almost never changes
#   2. pip/wheel/hatchling  — rarely changes
#   3. JAX + jaxlib        — changes on JAX version bumps only
#   4. ML dependencies     — changes on dep version bumps
#   5. Dev/test tools      — changes occasionally
#   6. pyproject.toml only — invalidates dep install only when deps change
#   7. pip install -e .    — installs project metadata (no source yet)
#   8. COPY source code    — changes on every code edit (cheap: just re-link)
# =============================================================================
FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV XLA_PYTHON_CLIENT_PREALLOCATE=false
ENV XLA_PYTHON_CLIENT_MEM_FRACTION=0.85
ENV JAX_PLATFORMS=cuda

# ---- 1. System packages (cached unless base image changes) ------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    python3-pip \
    git \
    curl \
    wget \
    vim \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python  python  /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/pip     pip     /usr/bin/pip3       1

# ---- 2. pip bootstrap + build backend (hatchling needed for pip install -e) --
RUN pip install --upgrade pip setuptools wheel hatchling

# ---- 3. JAX + CUDA (heaviest layer, changes least often) --------------------
RUN pip install \
    "jax[cuda12]" \
    --find-links https://storage.googleapis.com/jax-releases/jax_cuda_releases.html

# ---- 4. ML dependencies -----------------------------------------------------
RUN pip install \
    "flax>=0.10.0" \
    "optax>=0.2.0" \
    "transformers>=4.40.0" \
    "huggingface_hub>=0.23.0" \
    "safetensors>=0.4.0" \
    "chex>=0.1.86" \
    "numpy>=1.26"

# ---- 5. Dev / test tools ----------------------------------------------------
RUN pip install \
    torch --extra-index-url https://download.pytorch.org/whl/cpu

RUN pip install \
    "pytest>=8.0" \
    "pytest-xdist" \
    "ruff>=0.4" \
    "ipython" \
    "ipykernel"

# ---- 6. Project metadata only (invalidates on pyproject.toml changes) -------
WORKDIR /workspace
COPY pyproject.toml README.md ./
RUN mkdir -p nanovllm_jax && touch nanovllm_jax/__init__.py
RUN pip install -e ".[dev]" --no-deps

# ---- 7. Full source code (invalidates on any .py edit, but deps stay cached) -
COPY . .
RUN pip install -e ".[dev]"

CMD ["pytest", "tests/unit/", "-v"]
